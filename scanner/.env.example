# Required to write discoveries into Google Sheet Web App
SHEET_WEBHOOK_URL=
SHEET_INGEST_SECRET=

# Robinhood Chain RPC. Public RPC works; Alchemy is recommended for production.
RH_HTTP_URL=https://rpc.mainnet.chain.robinhood.com

# Optional. Scanner stays healthy without webhook and logs events locally.
DRY_RUN=false
BACKFILL_BLOCKS=120
POLL_MS=2000
HEARTBEAT_MS=30000
CANARY_TRACK_PENDING_BACKOFF_MS=300000

# Current Pons V2 / Uniswap V4 defaults are built in; override if protocol migrates.
PONS_V2_FACTORY=0x7ed598bcef8bd9edd8c97a195c6d13f40801ec7e
PONS_V1_FACTORY=0xa5aab3f0c6eeadf30ef1d3eb997108e976351feb
UNIV4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
UNIV4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Optional: only enable after verifying the current v3 factory.
UNIV3_FACTORY=

# Comma-separated extra quote tokens (USDG / official stock tokens, etc.)
QUOTE_TOKENS=

# Minute-level strong new-coin opportunity alerts.
# Keep real secrets only on the VPS; never commit them.
ALERT_POLL_MS=15000
ALERT_CONFIRMATIONS=2
ALERT_COOLDOWN_MS=1800000
ALERT_MIN_SCORE=70
ALERT_MIN_CONFIDENCE=60
ALERT_MIN_LIQUIDITY=10000
ALERT_MAX_RISK_PENALTY=8
ALERT_INSTANT_SCORE=85
ALERT_REQUIRE_ALL_CHANNELS=true

# Step 10 old-coin second-leg minute alerts.
# Direct VPS market polling; does not wait for the 5-minute Google Sheet refresh.
SECOND_LEG_POLL_MS=30000
SECOND_LEG_CONFIRMATIONS=2
SECOND_LEG_COOLDOWN_MS=1800000
SECOND_LEG_MIN_SCORE=70
SECOND_LEG_MIN_CONFIDENCE=70
SECOND_LEG_MIN_LIQUIDITY=200000
SECOND_LEG_MIN_VOLUME_H1=20000
SECOND_LEG_MIN_AMOUNT_RATIO=1.2
SECOND_LEG_MIN_HEAT=7
SECOND_LEG_INSTANT_SCORE=85
DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com

# Step 12 automatic old-coin candidate library.
# The checked-in JSON is manual override input only. The scanner consumes the generated /data watchlist.
SECOND_LEG_CANDIDATE_POLL_MS=120000
SECOND_LEG_CANDIDATE_MIN_AGE_MS=1800000
SECOND_LEG_CANDIDATE_MIN_PEAK_MULTIPLE=1.30
SECOND_LEG_CANDIDATE_MIN_LIQUIDITY=10000
SECOND_LEG_MAX_CANDIDATES=40
SECOND_LEG_MANUAL_WATCHLIST=
SECOND_LEG_GENERATED_WATCHLIST=/data/second_leg_watchlist.generated.json

# Bark (iPhone/iPad/macOS Bark app device key)
BARK_SERVER=https://api.day.app
BARK_DEVICE_KEY=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Post-alert + Shadow historical outcome tracking.
# Real alerts sample 1m/3m/5m; Shadow samples 2m/5m/10m and reuses fresh market_ticks before RPC.
HISTORY_POLL_MS=15000
HISTORY_MAX_ACTIVE_TOKENS=50
HISTORY_PROBE_GAP_MS=300
HISTORY_EXPORT_PORT=3105

# Step 8 threshold optimizer. Production changes remain recommendation-only.
THRESHOLD_MIN_TOTAL_SAMPLES=30
THRESHOLD_MIN_CANDIDATE_SAMPLES=12
THRESHOLD_MIN_UTILITY_DELTA=5

# Shadow threshold pool: no alerts, no production threshold changes.
# Captures lower-threshold candidates before they reach the live 70/60/10K baseline.
SHADOW_POLL_MS=30000
SHADOW_MAX_OPEN_TOKENS=40
SHADOW_REARM_MS=1800000

# Independent production health monitor.
# Health monitoring stays active and can auto-restart services, but user push notifications are OFF by default.
# Bark/Telegram are reserved for actionable trade signals unless HEALTH_PUSH_ALERTS is explicitly enabled.
HEALTH_PUSH_ALERTS=false
HEALTH_POLL_MS=30000
HEALTH_REMINDER_MS=1800000
HEALTH_STARTUP_GRACE_MS=90000
HEALTH_RESTART_AFTER_FAILURES=2
HEALTH_RESTART_COOLDOWN_MS=600000
HEALTH_DISK_WARN_PCT=80
HEALTH_DISK_CRITICAL_PCT=92
HEALTH_OPPORTUNITY_STALE_MS=180000
HEALTH_HTTP_TIMEOUT_MS=6500
HEALTH_OPPORTUNITY_HTTP_TIMEOUT_MS=12000
HEALTH_HTTPS_FAIL_CONFIRMATIONS=2
HEALTH_HTTPS_RECOVERY_CONFIRMATIONS=2
HEALTH_STATE_PATH=/data/rh_health_monitor_state.json
HEALTH_STATUS_PATH=/data/rh_health_status.json
HEALTH_PUBLIC_BASE=https://rh.192-236-234-216.sslip.io:8443

# Railway thin relay upstreams. The public relay remains guarded by SHEET_RELAY_TOKEN.
VPS_OPPORTUNITY_URL=
VPS_HISTORY_URL=
VPS_CALIBRATION_URL=
VPS_THRESHOLDS_URL=
VPS_SHADOW_URL=
VPS_SECOND_LEG_URL=
VPS_UPSTREAM_IP=
VPS_UPSTREAM_SERVERNAME=
SHEET_RELAY_TOKEN=

# Tradable/qualified ATH filters
QUALIFIED_DEX_MIN_LIQUIDITY_USD=10000
QUALIFIED_PONS_MIN_RESERVE_USD=2500
